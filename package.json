{
  "name": "vaiza",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vaiza: plan group trips without the WhatsApp chaos.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "e2e": "playwright test",
    "tokens": "node scripts/build-tokens.mjs",
    "contrast": "node scripts/contrast-report.mjs",
    "seed": "node --experimental-strip-types scripts/gen-seed.ts",
    "figma:sync": "node scripts/figma-sync.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:db",
    "build:artifact": "tsc --noEmit && vite build --config vite.artifact.config.ts && node scripts/artifact-page.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "@untitledui/icons": "^0.0.23",
    "flag-icons": "^7.6.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.5"
  }
}
