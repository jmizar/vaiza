{
  "$meta": {
    "source": "Sampled from Figma screenshots on 2026-11-06. APPROXIMATE: figma-sync replaces these with exact values from the file.",
    "rule": "Colours are Jaime's design decisions. Do not change them; flag contrast issues in design/a11y-flags.md instead."
  },
  "color": {
    "bg": "#F9FAFB",
    "surface": "#FFFFFF",
    "border": "#E7EAF0",
    "ink": "#191D26",
    "ink-2": "#424650",
    "ink-3": "#6B7584",
    "ink-4": "#878F9C",
    "placeholder": "#9CA4B1",
    "dot": "#D5D7DA",
    "navy": "#323546",
    "on-navy": "#FFFFFF",
    "brand": "#EA765C",
    "brand-start": "#EA755C",
    "brand-end": "#EC835C",
    "brand-disabled": "#EFB6AA",
    "brand-tint": "#FDF4EC",
    "on-brand": "#FFFFFF",
    "success": "#4E9D69",
    "success-tint": "#EBFAEE",
    "info": "#346EE7",
    "info-tint": "#E8F3FE",
    "neutral": "#7C8493",
    "neutral-tint": "#EFF2F6",
    "keyboard-blue": "#2F6FD6"
  },
  "gradient": {
    "brand": "linear-gradient(90deg, #EA755C 0%, #EC835C 100%)"
  },
  "font": {
    "family": "'Inter Variable', Inter, -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif"
  },
  "text": {
    "display": { "size": "28px", "line": "34px", "weight": "500", "tracking": "-0.01em" },
    "title": { "size": "22px", "line": "28px", "weight": "600", "tracking": "-0.01em" },
    "headline": { "size": "17px", "line": "22px", "weight": "600", "tracking": "0" },
    "body": { "size": "15px", "line": "21px", "weight": "400", "tracking": "0" },
    "callout": { "size": "14px", "line": "20px", "weight": "500", "tracking": "0" },
    "footnote": { "size": "13px", "line": "18px", "weight": "400", "tracking": "0" },
    "caption": { "size": "12px", "line": "16px", "weight": "400", "tracking": "0" },
    "overline": { "size": "11px", "line": "14px", "weight": "600", "tracking": "0.06em" }
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px",
    "phone": "44px",
    "pill": "999px"
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px"
  },
  "shadow": {
    "card": "0 1px 2px rgba(25, 29, 38, 0.04), 0 2px 8px rgba(25, 29, 38, 0.04)",
    "float": "0 4px 16px rgba(25, 29, 38, 0.10)",
    "sheet": "0 -8px 32px rgba(25, 29, 38, 0.12)"
  },
  "motion": {
    "fast": "150ms",
    "base": "250ms",
    "slow": "400ms",
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "spring": { "stiffness": 420, "damping": 34, "mass": 1 },
    "stagger": "30ms"
  },
  "size": {
    "touch-min": "44px",
    "app-max-width": "480px"
  }
}
